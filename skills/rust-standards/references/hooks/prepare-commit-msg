#!/usr/bin/env bash
unset STAGED_FILE_GATE_ONLY_VERIFIERS  # Commit hooks always run every required verifier.
export PYTHONDONTWRITEBYTECODE=1  # no .pyc caches inside .agents (2026-10-10 rule)
# prepare-commit-msg guard: enforce the pre-commit hook in owned projects.
#
# Why this hook and not pre-commit: `git commit --no-verify` suppresses
# pre-commit and commit-msg, but git gives no way to skip
# prepare-commit-msg. A non-zero exit here aborts the commit, which is what
# makes the no-bypass rule (§3.6 of the git-standards skill) enforceable.
#
# Why a global hook: core.hooksPath is set globally to ~/.git-hooks, so a
# repo-local .git/hooks/pre-commit is silently ignored. Nothing shadows the
# path this file lives in.
#
# The guard does NOT try to detect --no-verify (git exposes no env var for
# it, and this hook runs after the commit is already recorded). It runs the
# real gate itself, so the commit cannot be recorded with the checks
# unrun: pre-commit's own checks are re-executed here and must pass.
#
# Ownership is decided by asking GitHub which repos are the user's, not by
# a hardcoded owner list: every repo under the authenticated account, plus
# every repo under every org the account belongs to. A new org is therefore
# covered without editing this file. If GitHub cannot be reached the
# classifier returns ERROR, which falls through to enforcing — an
# unanswerable question must never become a free pass.

set -uo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
if [[ -z "$REPO_ROOT" ]]; then
    exit 0
fi

# Not a Rust repo: the rust-standards gate does not apply.
# Detect Rust from the complete index, not from unstaged files/directories.
TRACKED_PATHS=$(git -C "$REPO_ROOT" ls-files --cached) || exit 1
HEAD_PATHS=""
if git -C "$REPO_ROOT" rev-parse --verify --quiet HEAD >/dev/null; then
    HEAD_PATHS=$(git -C "$REPO_ROOT" ls-tree -r --name-only HEAD) || exit 1
fi
if ! printf '%s\n%s\n' "$TRACKED_PATHS" "$HEAD_PATHS" | grep -E '(^|/)Cargo\.toml$' >/dev/null; then
    exit 0
fi

GUARD=""
for candidate in \
    "$HOME/.agents/skills/git-standards/scripts/guard_no_verify.py" \
    "$HOME/.hermes/skills/git-standards/scripts/guard_no_verify.py"; do
    if [[ -f "$candidate" ]]; then
        GUARD="$candidate"
        break
    fi
done

# Without the classifier we cannot prove an exemption, so we stay enforced
# and run the gate below; the missing script is reported but not fatal on
# its own.
CLASSIFY_RC=2
if [[ -n "$GUARD" ]]; then
    CLASSIFY_RC=0
    python3 "$GUARD" --repo "$REPO_ROOT" >/dev/null 2>&1 || CLASSIFY_RC=$?
fi

# rc 0 = ENFORCED, 1 = EXEMPT, 2 = ERROR (treat as ENFORCED)
if [[ "$CLASSIFY_RC" -eq 1 ]]; then
    exit 0  # GitHub confirms the repo is not ours: follow upstream conventions
fi

SCRIPTS_DIR=""
for candidate in \
    "$HOME/.agents/skills/rust-standards/scripts" \
    "$HOME/.hermes/skills/rust-standards/scripts"; do
    if [[ -d "$candidate" ]] && [[ -f "$candidate/staged_file_gate.py" ]]; then
        SCRIPTS_DIR="$candidate"
        break
    fi
done

if [[ -z "$SCRIPTS_DIR" ]]; then
    echo "prepare-commit-msg: required rust-standards scripts not found" >&2
    exit 1
fi

STAGED_RS=$(git -C "$REPO_ROOT" diff --cached --name-only --diff-filter=ACMR -- \
    ':(exclude)target/*' | grep -E '\.(rs|toml)$' || true)

if [[ -z "$STAGED_RS" ]]; then
    exit 0
fi

# Match pre-commit's dependency-order gate, including complete manifest context.
if printf '%s\n' "$STAGED_RS" | grep -q '\.toml$'; then
    if ! python3 "$HOOK_DIR/dep_order_check.py" "$REPO_ROOT" "$SCRIPTS_DIR"; then
        echo "prepare-commit-msg: dependency-order gate FAILED" >&2
        exit 1
    fi
fi

if ! python3 "$SCRIPTS_DIR/staged_file_gate.py" "$REPO_ROOT" --staged; then
    echo "" >&2
    echo "prepare-commit-msg: rust-standards gate FAILED (enforced for owned repos)" >&2
    echo "  repo:   $REPO_ROOT" >&2
    echo "  scripts: $SCRIPTS_DIR" >&2
    echo "" >&2
    echo "This project is owned, so the pre-commit gate cannot be skipped" >&2
    echo "(git-standards §3.6). Fix the violations and re-commit:" >&2
    echo "  python3 $SCRIPTS_DIR/rust_pre_commit.py $REPO_ROOT" >&2
    exit 1
fi

exit 0
