#!/usr/bin/env bash
# Global pre-commit hook for eastspire Rust repos.
#
# Strategy: only check STAGED files (the diff about to be committed).
# This is fast, doesn't trigger on historical violations, and matches
# user intent — block NEW violations, not legacy debt.
#
# For full pre-coding loop (auto-fix + clippy + test-compile), run:
#   python3 ~/.agents/skills/rust-standards/scripts/rust_pre_commit.py <repo>
#
# This hook is the COMMIT-TIME safety net: any violation found here is
# a violation introduced by THIS commit, regardless of repo history.
#
# Installed at ~/.git-hooks/pre-commit with git config --global core.hooksPath.
# Escape hatch (NOT recommended, see rust-standards SKILL.md):
#   git commit --no-verify

set -euo pipefail

# -------------------------------------------------------------------
# Locate helpers (HOOK_DIR-relative, not cwd-relative)
# -------------------------------------------------------------------
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# -------------------------------------------------------------------
# Detect: Rust repo?
# -------------------------------------------------------------------
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
if [[ -z "$REPO_ROOT" ]]; then
    exit 0
fi

if ! find "$REPO_ROOT" -maxdepth 4 -name Cargo.toml -not -path '*/target/*' 2>/dev/null | head -1 | grep -q .; then
    exit 0  # not a Rust repo, skip
fi

# Locate rust-standards scripts dir
SCRIPTS_DIR=""
for candidate in \
    "$HOME/.agents/skills/rust-standards/scripts" \
    "$HOME/.hermes/skills/rust-standards/scripts"; do
    if [[ -d "$candidate" && -f "$candidate/audit_rust_standards.py" ]]; then
        SCRIPTS_DIR="$candidate"
        break
    fi
done
if [[ -z "$SCRIPTS_DIR" ]]; then
    echo "pre-commit hook: rust-standards skill not found, skipping audit" >&2
    exit 0
fi

# -------------------------------------------------------------------
# Get list of staged files (.rs / .toml) — skip binary, vendor, target
# -------------------------------------------------------------------
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- \
    ':(exclude)target/*' ':(exclude)*.lock' \
    | grep -E '\.(rs|toml)$' || true)

if [[ -z "$STAGED_FILES" ]]; then
    exit 0  # nothing Rust-related staged, skip
fi

# -------------------------------------------------------------------
# Run individual verifiers (only checks that scale to a file list)
# -------------------------------------------------------------------
# We do NOT call audit_rust_standards.py — it scans the whole repo
# and would block on legacy debt. Instead we call the file-level
# verifiers directly on each staged file.

echo "============================================================"
echo "pre-commit hook (rust-standards): staged-file audit gate"
echo "  repo:    $REPO_ROOT"
echo "  scripts: $SCRIPTS_DIR"
echo "  files:   $(echo "$STAGED_FILES" | wc -l | tr -d ' ')"
echo "============================================================"

VIOLATIONS=0
FAILED_FILES=()

# --- .toml files: dep order check (new-violation, staged vs HEAD) ---------
# Same model as the .rs gate below: only violations the commit INTRODUCES
# block. Historical bug (2026-10-09 FrameworkBenchmarks): the check ran
# verify_dep_order.py on the WHOLE repo and pinned any violation on the
# staged files, so an upstream-tracking fork carrying permanent §13.7 debt
# in manifests it does not own (34 of 37) could never commit any toml.
# verify_dep_order.py only accepts a DIRECTORY, so each staged manifest is
# audited as a single-file scratch tree - staged blob vs HEAD blob.
TOML_FILES=$(echo "$STAGED_FILES" | grep '\.toml$' || true)
if [[ -n "$TOML_FILES" ]]; then
    dep_order_count() {
        local scratch
        scratch=$(mktemp -d)
        cp "$1" "$scratch/Cargo.toml"
        python3 "$SCRIPTS_DIR/verify_dep_order.py" "$scratch" 2>/dev/null \
            | grep -oE '[0-9]+ violation' | grep -oE '^[0-9]+' | head -1
        rm -rf "$scratch"
    }
    while IFS= read -r toml_file; do
        [[ -z "$toml_file" ]] && continue
        STAGED_BLOB=$(mktemp)
        HEAD_BLOB=$(mktemp)
        if ! git show ":$toml_file" > "$STAGED_BLOB" 2>/dev/null; then
            rm -f "$STAGED_BLOB" "$HEAD_BLOB"
            continue
        fi
        new_count=$(dep_order_count "$STAGED_BLOB")
        [[ -z "$new_count" ]] && new_count=0
        old_count=0
        if git show "HEAD:$toml_file" > "$HEAD_BLOB" 2>/dev/null; then
            old_count=$(dep_order_count "$HEAD_BLOB")
            [[ -z "$old_count" ]] && old_count=0
        fi
        if [[ "$new_count" -gt "$old_count" ]]; then
            VIOLATIONS=$((VIOLATIONS + 1))
            FAILED_FILES+=("$toml_file (dep-order §13.7: $((new_count - old_count)) new violation(s) — run fix_dep_order.py)")
        fi
        rm -f "$STAGED_BLOB" "$HEAD_BLOB"
    done <<< "$TOML_FILES"
fi

# --- .rs files: new-violation gate (staged vs HEAD) -------------------
# Historical bug (2026-09-27): the loop below invoked each verifier with a
# FILE path, but every verify_*.py ends main() with `if not root.is_dir():
# return 2`. That made EVERY commit touching a .rs file fail regardless of
# content. It also counted working-tree violations, so files carrying legacy
# debt (lombok-macros/src/generate/fn.rs had 48 pre-existing doc-comment
# findings) stayed blocked forever.
#
# staged_file_gate.py imports the verifiers and diffs violation counts
# between HEAD and the worktree, so only NEW violations block. It owns the
# per-file loop now.
# The gate accepts .rs AND .toml: §2.5 (2026-10-09) forbids comments in
# every TOML file and every mod.rs, and verify_no_toml_mod_comments is the
# only TOML-aware verifier — it diffs staged-vs-HEAD like every other rule,
# so legacy TOML debt does not block unrelated commits.
GATE_FILES=$(echo "$STAGED_FILES" | grep -E '\.(rs|toml)$' || true)
if [[ -n "$GATE_FILES" ]]; then
    # shellcheck disable=SC2086
    if ! python3 "$SCRIPTS_DIR/staged_file_gate.py" "$REPO_ROOT" --file $GATE_FILES; then
        VIOLATIONS=$((VIOLATIONS + 1))
        FAILED_FILES+=("staged .rs/.toml files (staged_file_gate.py — new violations vs HEAD)")
    fi
fi

# -------------------------------------------------------------------
# Verdict
# -------------------------------------------------------------------
if [[ "$VIOLATIONS" -eq 0 ]]; then
    echo "  0 violations — commit allowed"
    echo "============================================================"
    exit 0
fi

echo ""
echo "  $VIOLATIONS violations across ${#FAILED_FILES[@]} check(s):"
for vf in "${FAILED_FILES[@]}"; do
    echo "    - $vf"
done
echo ""
echo "============================================================"
echo "pre-commit hook: FAIL — commit BLOCKED"
echo "============================================================"
echo "" >&2
echo "rust-standards violations introduced by this commit." >&2
echo "Fix them, then re-commit." >&2
echo "" >&2
echo "For full auto-fix loop (run BEFORE staging):" >&2
echo "  python3 $SCRIPTS_DIR/rust_pre_commit.py $REPO_ROOT" >&2
echo "" >&2
echo "To see detailed violation output, re-run the specific verifier on a file:" >&2
echo "  python3 $SCRIPTS_DIR/verify_doc_comment_format.py <file>" >&2
echo "" >&2
echo "Escape hatch (NOT recommended, see rust-standards SKILL.md):" >&2
echo "  git commit --no-verify" >&2
exit 1
